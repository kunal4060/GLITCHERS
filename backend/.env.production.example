# ====================================================================
# GLITCHERS Backend - Production Environment Template
# NEVER COMMIT REAL PRODUCTION CREDENTIALS TO SOURCE CONTROL
# ====================================================================

# 1. Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# 2. Supabase Production PostgreSQL, Auth & Realtime
# Obtain from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-production-project-id>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Google Gemini Multimodal AI API
# Obtain from: Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# 4. Google Cloud Platform (OAuth 2.0, Gmail API, Google Calendar API)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=<your-web-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Production Redirect URI (must match Google Cloud Authorized redirect URIs)
GOOGLE_REDIRECT_URI=https://<your-render-service-name>.onrender.com/api/auth/google/callback

# 5. Security & Session Signatures
# Generate a cryptographically secure 64-character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=production_ultra_secure_random_64_character_hex_secret_key_here

# 6. Observability & Crash Monitoring (Optional / Recommended)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
